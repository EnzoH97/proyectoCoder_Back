{{>navBar}}
<div class="container" style="max-width: 600px; margin: 2rem auto; padding: 1rem; border: 1px solid #ddd; border-radius: 8px;">
    <h1>Detalle de Producto</h1>
    <hr>
    {{#if product}}
        <h2>{{product.title}}</h2>
        {{#if product.thumbnails}}
            <img src="{{product.thumbnails.[0]}}" alt="{{product.title}}" style="max-width: 100%; height: auto; border-radius: 4px; margin-bottom: 1rem;">
        {{/if}}
        <p><strong>Descripción:</strong> {{product.description}}</p>
        <p><strong>Categoría:</strong> {{product.category}}</p>
        <p><strong>Precio:</strong> <span style="color: green; font-weight: bold; font-size: 1.25rem;">${{product.price}}</span></p>
        <p><strong>Stock disponible:</strong> {{product.stock}} unidades</p>
        <p><strong>Código:</strong> {{product.code}}</p>

        <button id="add-to-cart-btn" data-id="{{product._id}}" style="background-color: #28a745; color: white; padding: 0.75rem 1.5rem; border: none; border-radius: 4px; cursor: pointer; font-size: 1rem;">
            Agregar al Carrito
        </button>
    {{else}}
        <p>No se encontró información del producto.</p>
    {{/if}}
</div>

<script>
    document.getElementById('add-to-cart-btn')?.addEventListener('click', async (e) => {
        const pid = e.target.getAttribute('data-id');
        // Para pruebas, asumimos un ID de carrito estático o creado previamente
        let cid = localStorage.getItem('cartId');
        
        if (!cid) {
            // Si no hay carrito guardado localmente, creamos uno nuevo mediante el API
            const response = await fetch('/api/carts', { method: 'POST' });
            const data = await response.json();
            cid = data.cart._id;
            localStorage.setItem('cartId', cid);
        }

        try {
            const res = await fetch(`/api/carts/${cid}/products/${pid}`, {
                method: 'POST'
            });
            if (res.ok) {
                alert('¡Producto añadido al carrito con éxito!');
            } else {
                alert('Hubo un error al agregar el producto.');
            }
        } catch (error) {
            console.error(error);
        }
    });
</script>